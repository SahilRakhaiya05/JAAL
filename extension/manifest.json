{
  "manifest_version": 3,
  "name": "JAAL - scam shield",
  "short_name": "JAAL",
  "version": "1.0.0",
  "description": "Ambient scam shield for India. Checks chats, pastes, downloads and sites against reports from other people. Silent unless something matches.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "JAAL",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "options_page": "pages/options.html",
  "permissions": [
    "storage",
    "sidePanel",
    "notifications",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/extract.js",
        "src/core.js",
        "lib/ring.js",
        "src/card.js",
        "src/content/overlay.js",
        "src/content/paste.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://mail.google.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "include_globs": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://mail.google.com/*",
        "*/demo/*"
      ],
      "js": ["src/content/watch.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
