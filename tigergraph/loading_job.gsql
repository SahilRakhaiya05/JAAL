/*
 * GENERATED by tigergraph/load/gen-loading-job.mjs - edit common.mjs, not this file.
 *
 * Loading job for the TSV files written by load/export-to-csv.mjs.
 * Every vertex file has a header row; columns are referenced by name.
 * wcc_id / community_id are left at their defaults ("_"): GDS writes them.
 *
 * Edge types with several FROM/TO pairs get one LOAD line per pair, selected
 * with a WHERE filter on the from_type / to_type columns, and the vertex type
 * written after the id expression ($"from_id" Report) as GSQL requires for
 * multi-pair edge types.
 *
 * Run (GSQL shell on the server, files on the server's disk):
 *   RUN LOADING JOB load_jaal USING v_Phone="/path/out/v_Phone.tsv", ...
 * or from a client with pyTigerGraph / REST:
 *   POST /restpp/ddl/JAAL?tag=load_jaal&filename=v_Phone&sep=%09&eol=%0A  (body = file)
 * (load/push-restpp.mjs is the simpler path for demo-sized snapshots.)
 *
 * The embeddings statement needs TigerGraph 4.2+ (vector attributes).
 */
USE GRAPH JAAL

CREATE LOADING JOB load_jaal FOR GRAPH JAAL {
  DEFINE FILENAME v_Report;
  DEFINE FILENAME v_Reporter;
  DEFINE FILENAME v_Phone;
  DEFINE FILENAME v_UpiHandle;
  DEFINE FILENAME v_BankAccount;
  DEFINE FILENAME v_Url;
  DEFINE FILENAME v_Domain;
  DEFINE FILENAME v_ApkHash;
  DEFINE FILENAME v_CryptoAddress;
  DEFINE FILENAME v_MessageText;
  DEFINE FILENAME v_ScamPattern;
  DEFINE FILENAME v_Campaign;
  DEFINE FILENAME e_REPORTED;
  DEFINE FILENAME e_MENTIONS;
  DEFINE FILENAME e_MATCHES_PATTERN;
  DEFINE FILENAME e_PAYS_TO;
  DEFINE FILENAME e_RESOLVES_TO;
  DEFINE FILENAME e_HOSTED_ON;
  DEFINE FILENAME e_SAME_TEXT_AS;
  DEFINE FILENAME e_SIMILAR_SCRIPT;
  DEFINE FILENAME e_NEXT;
  DEFINE FILENAME e_IN_CAMPAIGN;
  DEFINE FILENAME embeddings;

  LOAD v_Report TO VERTEX Report VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"ts", $"surface", $"verdict", $"lang")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_Reporter TO VERTEX Reporter VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"cluster")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_Phone TO VERTEX Phone VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"country")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_UpiHandle TO VERTEX UpiHandle VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"psp")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_BankAccount TO VERTEX BankAccount VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"ifsc")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_Url TO VERTEX Url VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"shortener")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_Domain TO VERTEX Domain VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"brand_target")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_ApkHash TO VERTEX ApkHash VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"sha256")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_CryptoAddress TO VERTEX CryptoAddress VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"chain")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_MessageText TO VERTEX MessageText VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"lang")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_ScamPattern TO VERTEX ScamPattern VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"kind")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD v_Campaign TO VERTEX Campaign VALUES ($"id", $"value", $"state", $"report_count", $"first_seen", $"last_seen", $"source", $"trust", $"city", _, _, $"name", $"pattern", $"size", $"cluster_count", $"anchor")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";

  LOAD e_REPORTED TO EDGE REPORTED VALUES ($"from_id" Reporter, $"to_id" Report, $"ts", $"weight", $"weight")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MENTIONS TO EDGE MENTIONS VALUES ($"from_id" Report, $"to_id" Phone, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "Phone"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MENTIONS TO EDGE MENTIONS VALUES ($"from_id" Report, $"to_id" UpiHandle, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "UpiHandle"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MENTIONS TO EDGE MENTIONS VALUES ($"from_id" Report, $"to_id" BankAccount, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "BankAccount"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MENTIONS TO EDGE MENTIONS VALUES ($"from_id" Report, $"to_id" Url, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "Url"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MENTIONS TO EDGE MENTIONS VALUES ($"from_id" Report, $"to_id" Domain, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "Domain"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MENTIONS TO EDGE MENTIONS VALUES ($"from_id" Report, $"to_id" ApkHash, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "ApkHash"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MENTIONS TO EDGE MENTIONS VALUES ($"from_id" Report, $"to_id" CryptoAddress, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "CryptoAddress"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_MATCHES_PATTERN TO EDGE MATCHES_PATTERN VALUES ($"from_id" Report, $"to_id" ScamPattern, $"ts", $"weight", $"weight")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_PAYS_TO TO EDGE PAYS_TO VALUES ($"from_id" Phone, $"to_id" UpiHandle, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Phone" AND $"to_type" == "UpiHandle"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_PAYS_TO TO EDGE PAYS_TO VALUES ($"from_id" Phone, $"to_id" BankAccount, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Phone" AND $"to_type" == "BankAccount"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_PAYS_TO TO EDGE PAYS_TO VALUES ($"from_id" Phone, $"to_id" CryptoAddress, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Phone" AND $"to_type" == "CryptoAddress"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_PAYS_TO TO EDGE PAYS_TO VALUES ($"from_id" UpiHandle, $"to_id" UpiHandle, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "UpiHandle" AND $"to_type" == "UpiHandle"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_PAYS_TO TO EDGE PAYS_TO VALUES ($"from_id" UpiHandle, $"to_id" BankAccount, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "UpiHandle" AND $"to_type" == "BankAccount"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_PAYS_TO TO EDGE PAYS_TO VALUES ($"from_id" UpiHandle, $"to_id" CryptoAddress, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "UpiHandle" AND $"to_type" == "CryptoAddress"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_RESOLVES_TO TO EDGE RESOLVES_TO VALUES ($"from_id" Url, $"to_id" Domain, $"ts", $"weight", $"weight")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_HOSTED_ON TO EDGE HOSTED_ON VALUES ($"from_id" ApkHash, $"to_id" Url, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "ApkHash" AND $"to_type" == "Url"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_HOSTED_ON TO EDGE HOSTED_ON VALUES ($"from_id" ApkHash, $"to_id" Domain, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "ApkHash" AND $"to_type" == "Domain"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_SAME_TEXT_AS TO EDGE SAME_TEXT_AS VALUES ($"from_id" Report, $"to_id" MessageText, $"ts", $"weight", $"weight")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_SIMILAR_SCRIPT TO EDGE SIMILAR_SCRIPT VALUES ($"from_id" MessageText, $"to_id" MessageText, $"ts", $"weight", $"weight")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_NEXT TO EDGE NEXT VALUES ($"from_id" Report, $"to_id" Report, $"ts", $"weight", $"weight", $"gap_hours")
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" Report, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Report" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" MessageText, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "MessageText" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" Phone, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Phone" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" UpiHandle, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "UpiHandle" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" BankAccount, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "BankAccount" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" Url, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Url" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" Domain, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "Domain" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" ApkHash, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "ApkHash" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";
  LOAD e_IN_CAMPAIGN TO EDGE IN_CAMPAIGN VALUES ($"from_id" CryptoAddress, $"to_id" Campaign, $"ts", $"weight", $"weight")
    WHERE $"from_type" == "CryptoAddress" AND $"to_type" == "Campaign"
    USING SEPARATOR="\t", HEADER="true", EOL="\n";

  // TigerVector (4.2+): id <TAB> comma-separated 256 floats, no header
  LOAD embeddings TO VECTOR ATTRIBUTE embedding ON VERTEX MessageText VALUES ($0, SPLIT($1, ","))
    USING SEPARATOR="\t", HEADER="false", EOL="\n";
}
