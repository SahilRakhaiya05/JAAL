<?xml version="1.0" encoding="utf-8"?>
<!--
  VerdictCard (SPEC): width min(screen-32dp, 400dp) set by the caller, radius 20, padding 20, 1px hairline,
  no shadow. Rows: StateChip 24 + source app 13; verdict 22/600; reason 15 (<=2 lines); ring 72; <=2 actions 48.
  Every height is wrap_content so the card grows at 200% font scale and the verdict is never truncated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal">

    <!-- Reported: 2px caution rule on the left, no fill. -->
    <View
        android:id="@+id/rule"
        android:layout_width="@dimen/rule_width"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/state_caution"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/card_pad"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="@dimen/card_pad">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip"
                style="@style/T.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_reported"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:minHeight="@dimen/chip_height"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:textColor="@color/state_caution" />

            <TextView
                android:id="@+id/source"
                style="@style/T.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/close"
                android:layout_width="@dimen/tap"
                android:layout_height="@dimen/tap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_dismiss"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/headline"
            style="@style/T.Verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/reason"
            style="@style/T.Body.Lo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/personal"
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <app.jaal.android.ui.RingView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ring_thumb"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/primary"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Button
                android:id="@+id/secondary"
                style="@style/Btn.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
