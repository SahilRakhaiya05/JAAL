# JAAL server. Every variable is optional: unset = local/demo mode (shown in /api/health).
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# Salt for re-hashing reporter/device/network ids. Set a long random value in production.
REPORTER_SALT=change-me-to-a-long-random-string

# Graph engine: memory (default) | tigergraph (mirrors writes, runs the 6 GSQL queries, falls back to memory)
GRAPH_BACKEND=memory
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPH=JAAL
TG_SECRET=
TG_TOKEN=

# Dodo Payments (Checkout Sessions + Standard Webhooks + usage events)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=
DODO_ENV=test_mode
# Metered API tier: comma-separated "apiKey:dodoCustomerId" pairs (callers send x-jaal-key)
JAAL_API_KEYS=

# viaSocket webhook trigger URL (fired on confirmed verdicts / new reports)
VIASOCKET_WEBHOOK_URL=

# Cake Wallet / crypto payment URIs
CAKE_XMR_ADDRESS=
CAKE_BTC_ADDRESS=
# Optional monero-wallet-rpc for a fresh subaddress per customer (create_address)
MONERO_WALLET_RPC_URL=

# Wispr Flow speech-to-text (invite-only API); without it /api/voice takes { transcript }
WISPR_API_KEY=

# Claude (reason polish + messy-text extraction, never blocks a verdict)
ANTHROPIC_API_KEY=

# Seed only: free abuse.ch key for URLhaus (public dumps return HTTP 410)
URLHAUS_AUTH_KEY=
